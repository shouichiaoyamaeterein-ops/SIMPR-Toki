Private Sub PrtFLDEdit()
    Static sw_Val           As Integer      ' ì˙íˆçÄñ⁄ä‘äu
    Static sw_ValR          As Integer      ' è„â∫ä‘äu

    B1_K_Day(0) = " 1ì˙"
    sw_Val = B1_K_LINEDayY.X2 - B1_K_LINEDayY.X1
    sw_ValR = B1_K_LINEDay(0).Y2 - B1_K_LINEDay(0).Y1


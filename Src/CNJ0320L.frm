Private Function PrintProc()
    PgBk_Torcd = ""
    Erase wDSu: Erase wMSu: wHin_Flg = 0

    Do Until Not HNJ_RDSTS
        With HNJ
            
            If RTrim$(.éËîzêÊ) <> PgBk_Torcd Then
                CisPrt.cLine = 99
                PrtK_Hinbn = RTrim$(.ïiî‘)
                PrtK_Torcd = RTrim$(.éËîzêÊ)
                PrtK_Ukeir = RTrim$(.éÛì¸)
            End If
            
            Call HeadWrite
            PgBk_Torcd = RTrim$(.éËîzêÊ)
            
            If CisFun.Val2(.î[ä˙) <= 2 Then
'               ( åéó èÓïÒ )
                
                If wHin_Flg = 0 Then
'                   < ïiî‘èÓïÒ [ çså©èoÇµ ] >
                    B1_Hinbn = EditHinbn(.ïiî‘, .ïiî‘ï“èW)
                    B1_NTorcd = RTrim$(.íºëóêÊ)
'*---------------------------------------------------* Å§Å§Å§ 2005/02/10 Update Start Å§Å§Å§
'                   B1_Ukeir = ""
                    B1_Ukeir = DBSelect_HTM(.ïiî‘, .éËîzêÊ, .éÛì¸, 1, .íºëóêÊ)
'*---------------------------------------------------* Å¢Å¢Å¢ 2005/02/10 Update End   Å¢Å¢Å¢
                    B1_Seban = RTrim$(.îwî‘çÜ)
                    If RTrim$(.ÉTÉCÉNÉã) <> "" Then
                        B1_Cycle1 = Mid$(.ÉTÉCÉNÉã, 1, 1)
                        B1_Cycle2 = CisFun.RSetFld(Mid$(.ÉTÉCÉNÉã, 2, 2), 2, "#")
                        B1_Cycle3 = CisFun.RSetFld(Mid$(.ÉTÉCÉNÉã, 4, 2), 2, "#")
                    End If
                    B1_Syuyo = CisFun.RSetFld(.é˚óeêî, 5, "##")
                    B1_HinNM = RTrim$(.ïiñº)
                    
                    Erase wMSu
                    wHin_Flg = 1
                End If
        
'               ( åéó êîëﬁî )
                wMSu(CisFun.Val2(.î[ä˙)) = .êîó 
            Else
'               ( ì˙ó èÓïÒ )
                gInt = CisFun.Val2(Mid$(.î[ä˙, 7, 2))
                wDSu(gInt) = .êîó 
            End If
        End With
    
        With CisPrt
            .cDataCnt = .cDataCnt + 1
            .dpCountDisp Format(.cPage, "#,###") & " ï≈"
        End With

        Call HNJReadNext
    
        If Not HNJ_RDSTS Or _
           PrtK_Hinbn <> RTrim$(HNJ.ïiî‘) Or _
           PrtK_Torcd <> RTrim$(HNJ.éËîzêÊ) Or _
           PrtK_Ukeir <> RTrim$(HNJ.éÛì¸) Then

'           ( åéó ÉZÉbÉg )
            For gInt = 0 To 2
' *CHG* 2004/05/13
'                B1_NJSU(gInt) = CisFun.RSetFld(wMSu(0), 10, "#,###")
                B1_NJSU(gInt) = CisFun.RSetFld(wMSu(gInt), 10, "#,###")
            Next gInt
'           ( ì˙ó ÉZÉbÉg )
            For gInt = 1 To End_Day
                B1_NSU(gInt - 1) = CisFun.RSetFld(wDSu(gInt), 6, "#")
            Next gInt
                
'           *----------------*

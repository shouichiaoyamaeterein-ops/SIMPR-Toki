                Call .ClrLstFld("B1")
            End With

            Erase wDSu: Erase wMSu: wHin_Flg = 0
            PrtK_Hinbn = RTrim$(HNJ.ïiî‘)
            PrtK_Torcd = RTrim$(HNJ.éËîzêÊ)

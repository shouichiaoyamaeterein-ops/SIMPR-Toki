    With CisPrt
        If .iLineMax >= .cLine + 1 Then Exit Function

        If .cPage > 0 Then Call TailWrite
        .cLine = 0
        .cPage = .cPage + 1

        .ClrLstFld ("H1")   'HEADïîì‡óeè¡ãé
        .ClrLstFld ("B1")

        H1_YYMM = Mid$(TGet_YM, 1, 4) & "îN" & Mid$(TGet_YM, 5, 2) & "åéìx"
        H1_Torcd = RTrim$(NTT.å_ñÒêÊ)

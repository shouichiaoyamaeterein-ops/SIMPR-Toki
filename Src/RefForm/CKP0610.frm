'****************************
'*      分類切替
'****************************
Private Sub Op_Sort_Click(Index As Integer)
    If ProcHB = "H1" Then Exit Sub
    If Adodc1.Recordset.RecordCount <> 0 Then Call BodySet
    SendKeys "{TAB}"
End Sub
'****************************
'*      ボディ内容セット
'****************************
Private Function BodySet() As Boolean
    BodySet = False
    gSL_Select = "SELECT * FROM 機械マスタ"
    mSL_OrderA = " Order By 機械"
    mSL_OrderD = " Order By 機械 Desc"
' 選択条件セット
    mSL_SelectW = ""
    If Op_Sort(0) Then
        Adodc1.RecordSource = gSL_Select & mSL_SelectW & mSL_OrderA
    Else
        Adodc1.RecordSource = gSL_Select & mSL_SelectW & mSL_OrderD
    End If
    Adodc1.Refresh
    If Adodc1.Recordset.RecordCount = 0 Then
        With CisFun
            .MB_Lines = 3
            .MB_MSG(2) = "     該当するデータはありません            "
            .MB_Title = ""
            .MB_Button = OK
            .MBOX
            Call PB_END_Click
        End With
        Exit Function
    End If
    BodySet = True
End Function
